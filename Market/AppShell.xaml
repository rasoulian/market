<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Market.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Market.Resources.Languages"
    xmlns:pages="clr-namespace:Market.Pages"
    Title="Market"
    Shell.FlyoutBehavior="Disabled">


    <TabBar>
        <Tab Title="{Static local:AppResources.Vitrin}" Icon="{FontImage FontFamily=MaterialIconsOutlined-Regular, Glyph=&#xea12;}">
            <ShellContent
                Title="Bindings"
                ContentTemplate="{DataTemplate pages:VitrinPage}"
                Route="Bindings" />
        </Tab>
        <Tab Title="{Static local:AppResources.Home}" Icon="{FontImage FontFamily=MaterialIconsOutlined-Regular, Glyph=&#xe88a;}">
            <ShellContent
                Title="Home"
                ContentTemplate="{DataTemplate pages:MainPage}"
                Route="MainPage" />
        </Tab>
        <Tab Title="{Static local:AppResources.Visit}" Icon="{FontImage FontFamily=MaterialIconsOutlined-Regular, Glyph=&#xe855;}">
            <ShellContent
                Title="Events"
                ContentTemplate="{DataTemplate pages:VisitPage}"
                Route="Event" />
        </Tab>

        <Tab Title="{Static local:AppResources.Visit}" Icon="{FontImage FontFamily=MaterialIconsOutlined-Regular, Glyph=&#xe855;}">
            <ShellContent
                Title="Events"
                ContentTemplate="{DataTemplate pages:VisitPage}"
                Route="Event" />
        </Tab>
        <Tab Title="{Static local:AppResources.Profile}" Icon="{FontImage FontFamily=MaterialIconsOutlined-Regular, Glyph=&#xe87c;}">
            <ShellContent
                Title="MVVM Goodness"
                ContentTemplate="{DataTemplate pages:ProfilePage}"
                Route="MvvmSample" />
        </Tab>

    </TabBar>
</Shell>
