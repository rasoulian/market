<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="Market.Pages.Popups.BillPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:Market.Controls"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:Market.ViewModels"
    x:DataType="vm:BillViewModel">

    <toolkit:Popup.Resources>
        <converters:NumberToCurrencyConverter x:Key="numToCurrency" />

    </toolkit:Popup.Resources>

    <VerticalStackLayout
        Padding="20"
        FlowDirection="RightToLeft"
        WidthRequest="400">
        <Label FontFamily="IRANSans" FontSize="Title">
            واریز مبلغ
        </Label>

        <Border>
            <VerticalStackLayout>
                <Entry
                    x:Name="entry2"
                    FontFamily="IRANSansMedium"
                    FontSize="Large"
                    HorizontalTextAlignment="End"
                    Keyboard="Numeric"
                    Text="" />
                <Label
                    FontFamily="IRANSansMedium"
                    FontSize="11"
                    Text="{Binding Text, Source={x:Reference entry2}, Converter={StaticResource numToCurrency}, StringFormat='{0} تومان', ConverterParameter='fa-IR'}"
                    TextColor="Black" />
            </VerticalStackLayout>
        </Border>

        <Border>
            <Label
                Padding="0,40,0,0"
                FontFamily="IRANSans"
                FontSize="Small"
                HorizontalOptions="Start"
                LineBreakMode="WordWrap"
                SemanticProperties.HeadingLevel="Level2"
                Style="{StaticResource SubHeadline}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span FontFamily="IRANSans">
                            <Span.Text>
                                جمع مبالغ را به کارت
                            </Span.Text>
                        </Span>
                        <Span
                            FontFamily="IRANSans"
                            Text=" 6219861904189684 "
                            TextColor="Blue"
                            TextDecorations="Underline">
                            <Span.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenUrlCommand}" CommandParameter="https://app.rasoulian.ir/Market/android" />
                            </Span.GestureRecognizers>
                        </Span>
                        <Span FontFamily="IRANSans">
                            <Span.Text>
                                واریز نمایید.
                            </Span.Text>
                        </Span>
                    </FormattedString>
                </Label.FormattedText>
            </Label>

        </Border>


        <Button
            Margin="0,10,0,0"
            FontAttributes="Bold"
            FontFamily="IRANSans"
            HorizontalOptions="End"
            Text="ثبت"
            TextColor="White"
            WidthRequest="100" />
    </VerticalStackLayout>



</toolkit:Popup>